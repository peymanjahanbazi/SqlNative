<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <Authors>Peyman Jahanbazi</Authors>
        <Product>SqlNative</Product>
        <Copyright>Copyright © $([System.DateTime]::Now.Year) your-name</Copyright>
        <PackageProjectUrl>https://github.com/peymanjahanbazi/SqlNative</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/peymanjahanbazi/SqlNative</PackageProjectUrl>
        <RepositoryUrl>https://github.com/peymanjahanbazi/SqlNative</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
</Project>