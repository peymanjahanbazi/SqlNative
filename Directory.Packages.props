        <PackageVersion Include="Npgsql" Version="9.0.3" />
        <PackageVersion Include="Microsoft.Data.SqlClient" Version="5.2.2" />
        <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    </ItemGroup>
</Project>