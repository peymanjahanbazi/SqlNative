<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <PackageId>SqlNative.AspNetCore</PackageId>
    <Authors>Peyman Jahanbazi</Authors>
    <Description>ASP.NET Core integration for the SqlNative light-weight ORM. Registers your SqlNativeContext in
      the host's IServiceCollection, opens the DbConnection per scope and closes it on disposal, so controllers and
      minimal API endpoints can take the context as a constructor parameter. Works with any ADO.NET provider.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>SqlNative.AspNetCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared ASP.NET Core framework. Brings in Microsoft.AspNetCore.* reference assemblies. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlNative\SqlNative.csproj" />
  </ItemGroup>

</Project>