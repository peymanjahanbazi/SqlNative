<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <PackageId>SqlNative.AspNetCore</PackageId>
    <Authors>Peyman Jahanbazi</Authors>
    <Description>ASP.NET Core integration for SqlNative. Provides DI extension methods to register
      SqlNative Query/Context types with the host's IServiceCollection and to expose them
      over minimal APIs and controllers.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>SqlNative.AspNetCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared ASP.NET Core framework. Brings in Microsoft.AspNetCore.* reference assemblies. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlNative\SqlNative.csproj" />
  </ItemGroup>

</Project>