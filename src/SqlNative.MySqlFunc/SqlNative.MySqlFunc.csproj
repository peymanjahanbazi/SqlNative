<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net461;netstandard2.0;net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>SqlNative.MySqlFunc</PackageId>
    <Authors>Peyman Jahanbazi</Authors>
    <Description>Optional MySQL and MariaDB function catalog for the SqlNative light-weight ORM. Adds the
      MySqlFunctions class with 376 built-in functions and operators covering strings, dates, numeric, JSON, spatial,
      aggregates, window functions and more, exposed as documented C# methods that return SQL text. Function names
      and argument counts are compile-checked, the XML docs record argument order and MySQL/MariaDB availability, and
      the SQL stays fully visible.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--<RootNamespace>SqlNative</RootNamespace>-->
    <IsPackable>true</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
  </ItemGroup>

  <!--<ItemGroup>
    <ProjectReference Include="..\SqlNative\SqlNative.csproj" />
  </ItemGroup>-->

</Project>