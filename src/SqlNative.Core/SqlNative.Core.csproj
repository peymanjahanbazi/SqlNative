<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net461;netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <PackageId>SqlNative.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>Peyman</Authors>
    <Description>Core helpers for SqlNative: engine identifier helpers, CLR type mappers, and the
      DatabaseEngine enum.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>SqlNative.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3"
      PrivateAssets="All" />
  </ItemGroup>
</Project>