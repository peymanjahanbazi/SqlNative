<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net461;netstandard2.0;net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>SqlNative</PackageId>
    <Description>A light-weight ORM for .NET that doesn't hide the database. Map tables to C# types, get CRUD and
      result mapping, and write the SQL yourself with tables, columns and expressions as compile-checked C#
      identifiers. Runs on any ADO.NET DbConnection: SQL Server, MySQL, PostgreSQL and Oracle.</Description>
    <PackageTags>sql;database;native;orm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- PackagePath "\" puts the README at the package root, which is where
       NuGet.org looks for the file named by PackageReadmeFile. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SqlNative.Core\SqlNative.Core.csproj" />
  </ItemGroup>
</Project>