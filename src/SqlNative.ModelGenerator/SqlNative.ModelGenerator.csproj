<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>SqlNative.ModelGenerator</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sqlnative-gen</ToolCommandName>
    <Description>Code generator for the SqlNative light-weight ORM. Reads a live SQL Server, MySQL, PostgreSQL or
      Oracle schema and writes a complete typed data-access layer: a table structure class, a row model, a CRUD entity
      and a context, per table. Installed as the 'sqlnative-gen' dotnet tool.</Description>
    <PackageTags>sql;database;native;orm;codegen;generator</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <TargetFrameworks>net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>SqlNative.ModelGenerator</RootNamespace>
    <AssemblyName>SqlNative.ModelGenerator</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlNative\SqlNative.csproj" />
  </ItemGroup>

</Project>